/.local-distribution/
/dist/
/build/
*.spec
JarvisInstaller*.exe
JarvisInstaller*.bin

# Local caches and generated assets / diagnostic recordings
/.cache/
/.tripo/
/artifacts/

# Python environments and generated files
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/*.py[cod]
**/*.egg-info/
/scripts/models/.model-build/
/scripts/models/cache/
/scripts/models/source/
/models/*
!/models/README.md

